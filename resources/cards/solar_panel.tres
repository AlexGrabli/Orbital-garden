[gd_resource type="Resource" script_class="CardResource" load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/data/effect_data.gd" id="1"]
[ext_resource type="Script" path="res://scripts/data/card_resource.gd" id="2"]

[sub_resource type="Resource" id="day_fx"]
script = ExtResource("1")
type = &"generate"
value = 4.0
conditions = {
&"resource": &"energy"
}

[sub_resource type="Resource" id="night_fx"]
script = ExtResource("1")
type = &"convert"
radius = 2.0
conditions = {
&"from": &"energy",
&"to": &"charge",
&"rate": 2
}

[resource]
script = ExtResource("2")
id = &"solar_panel"
name = "Солнечная панель"
flavor_text = "Днём копит, ночью кормит турели."
tags = [&"мех", &"энергия", &"экономика"]
cost_water = 1
hp = 20
rarity = 0
day_property = &"none"
day_effect = SubResource("day_fx")
night_effect = SubResource("night_fx")
