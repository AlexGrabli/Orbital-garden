[gd_resource type="Resource" script_class="CardRegistry" load_steps=8 format=3]

[ext_resource type="Script" path="res://scripts/data/card_registry.gd" id="1"]
[ext_resource type="CardResource" path="res://resources/cards/turret_laser.tres" id="2"]
[ext_resource type="CardResource" path="res://resources/cards/wall_barrier.tres" id="3"]
[ext_resource type="CardResource" path="res://resources/cards/solar_panel.tres" id="4"]
[ext_resource type="CardResource" path="res://resources/cards/moisture_condenser.tres" id="5"]
[ext_resource type="CardResource" path="res://resources/cards/cactus_battery.tres" id="6"]
[ext_resource type="CardResource" path="res://resources/cards/chicken_incubator.tres" id="7"]

[resource]
script = ExtResource("1")
